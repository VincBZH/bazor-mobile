# BAZOR runtime data (logs, transient state, generated status)
pc-relay/BAZOR_DATA/

# Python runtime/cache
__pycache__/
*.py[cod]

# Local transient files
*.log

# Secrets / local credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.secrets/
secrets/

# Local Android / IDE state
local.properties
android/**/local.properties

# Local backups that must not be committed
*.bak
*.backup
