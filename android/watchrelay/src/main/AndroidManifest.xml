<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="com.bazor.montre.permission.RELAY"/>

    <application
        android:allowBackup="false"
        android:label="BAZOR Relay (Skype)"
        android:icon="@android:drawable/ic_dialog_info"
        android:theme="@android:style/Theme.DeviceDefault">

        <receiver
            android:name=".RelayReceiver"
            android:exported="true"
            android:permission="com.bazor.montre.permission.RELAY">
            <intent-filter>
                <action android:name="com.bazor.montre.RELAY_TO_C28"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
